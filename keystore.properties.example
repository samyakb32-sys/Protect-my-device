# Copy to keystore.properties (git-ignored) and fill in. Paths are relative to the project root.
# Create the keystore once and back it up: every future update must be signed with the same key.
#   keytool -genkeypair -v -keystore release.jks -alias protect -keyalg RSA -keysize 4096 -validity 10000
storeFile=release.jks
storePassword=
keyAlias=protect
keyPassword=
