rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Thief photos. Only the account that owns the device may upload or view them
    // (the dashboard and the app both show them, so "any signed-in user" is not enough).
    match /thieves/{deviceId}/{file} {
      function ownsDevice() {
        return request.auth != null &&
          firestore.get(/databases/(default)/documents/devices/$(deviceId)).data.owner == request.auth.uid;
      }
      allow create: if ownsDevice() && request.resource.size < 5 * 1024 * 1024;
      allow read: if ownsDevice();
    }
  }
}
