rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Thief photos: any signed-in session of the owner may upload; reading is via owner tooling only.
    match /thieves/{deviceId}/{file} {
      allow create: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
      allow read: if request.auth != null;
    }
  }
}
